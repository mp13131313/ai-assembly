# Required: Anthropic API key for all generation passes (2, 3, 4a, 4b, 5, 6,
# 7-pre, 7b, 7c, Coherence Threading, Derive). Get at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required: Perplexity API key for Pass 1a (Research Dossier).
# Uses sonar-deep-research. Get at https://www.perplexity.ai/settings/api
# (~$2-4 per voice)
PERPLEXITY_API_KEY=

# Required: Google API key for Pass 1b (Broad Scan) and Pass 7a fallback.
# Uses gemini-2.5-pro. Get at https://aistudio.google.com/apikey (free tier OK)
GOOGLE_API_KEY=

# Required: OpenAI API key for Pass 7a (primary cross-model validation) and
# Pass 3 conditional ChatGPT Deep Research. Uses gpt-4o or latest.
# Get at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Models are chosen in model_routing.json (repo root) — edit that file.
# These legacy env vars still override it for their one step:
# PERPLEXITY_MODEL=sonar-deep-research   # personas.pass_1a_perplexity
# GEMINI_MODEL=gemini-2.5-pro            # personas.pass_1b_gemini

# TODO: PERSONA_THINKING_BUDGET and PERSONA_VOICE_BATCH are documented here
# but not currently consumed by any code path. Re-add as live env vars
# when per-voice thinking budget overrides and parallel batching are implemented.
